# Copy to .env.local for local NVIDIA testing (this file is gitignored if named .env.local)

NEXT_PUBLIC_ENABLE_LIVE_ANSWER=true
NEXT_PUBLIC_ENABLE_LIVE_EVALUATORS=true

# Paste your key from https://build.nvidia.com
NVIDIA_API_KEY=

NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EVALUATOR_MODEL=meta/llama-3.1-8b-instruct

# Uncomment to test mixed live+mock evaluator results locally:
# DEV_FORCE_MOCK_EVALUATORS=research